<% content_for :title, "Sign in" %>

<h1>Sign in</h1>

<%= form_with url: session_path, class: "stacked-form" do |form| %>
  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "username" %>
  </div>

  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password" %>
  </div>

  <%= form.submit "Sign in" %>
<% end %>
