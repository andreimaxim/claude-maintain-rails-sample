<% content_for :title, @note.title %>

<article class="note-page<%= " highlight-#{@note.highlight_color}" if @note.highlight_color.present? %>">
  <div class="page-heading">
    <h1><%= @note.title %></h1>
    <%= link_to "Edit note", edit_note_path(@note), class: "button" %>
  </div>

  <p class="meta">
    <%= @note.notebook.name %> ·
    <span class="status status-<%= @note.status %>"><%= @note.status.humanize %></span> ·
    <time datetime="<%= @note.created_at.iso8601 %>"><%= l @note.created_at, format: :short %></time>
  </p>

  <%= render "tags", tags: @note.tags %>

  <%= @note.body %>
</article>

<p><%= link_to "Back to notes", notes_path %></p>
