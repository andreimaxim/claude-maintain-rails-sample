<% content_for :title, "Notes" %>

<div class="page-heading">
  <h1>Notes</h1>
  <div class="actions">
    <%= button_to "Email today's digest", digest_path, class: "secondary-button", aria: { describedby: "digest_hint" } %>
    <%= link_to "New note", new_note_path, class: "button" %>
  </div>
</div>
<p id="digest_hint" class="hint">Emails you the ready notes updated today. You can request it once a day.</p>

<%= form_with(model: nil, url: notes_path, method: :get, class: "search", html: { role: "search" }) do |form| %>
  <div class="field">
    <%= form.label :query, "Title contains" %>
    <%= form.search_field :query, value: params[:query] %>
  </div>

  <div class="field">
    <%= form.label :notebook_id, "Notebook" %>
    <%= form.select :notebook_id, options_from_collection_for_select(@notebooks, :id, :name, @notebook&.id), include_blank: "All notebooks" %>
  </div>

  <div class="field">
    <%= form.label :status %>
    <%= form.select :status, options_for_select(Note.statuses.keys.map { |status| [status.humanize, status] }, params[:status]), include_blank: "Any status" %>
  </div>

  <div class="field">
    <%= form.label :per_page, "Per page" %>
    <%= form.select :per_page, options_for_select([5, 10, 25, 50], @pagy.items) %>
  </div>

  <div class="actions">
    <%= form.submit "Search", name: nil %>
    <%= link_to "Clear", notes_path %>
  </div>
<% end %>

<% if @notes.any? %>
  <p class="range"><%== pagy_info(@pagy, item_name: "note".pluralize(@pagy.count)) %></p>

  <ol class="notes">
    <% @notes.each do |note| %>
      <li id="<%= dom_id(note) %>" class="note<%= " highlight-#{note.highlight_color}" if note.highlight_color.present? %>">
        <h2><%= link_to note.title, note_path(note) %></h2>
        <p class="meta">
          <%= note.notebook.name %> ·
          <span class="status status-<%= note.status %>"><%= note.status.humanize %></span> ·
          <time datetime="<%= note.created_at.iso8601 %>"><%= l note.created_at, format: :short %></time>
        </p>
        <%= render "tags", tags: note.tags %>
        <% if note.body.present? %>
          <p><%= truncate(note.body.to_plain_text, length: 160) %></p>
        <% end %>
      </li>
    <% end %>
  </ol>

  <% if @pagy.pages > 1 %>
    <nav class="pagination" aria-label="Pages">
      <%= link_to "Previous", pagy_url_for(@pagy, @pagy.prev), rel: "prev" if @pagy.prev %>
      <%= link_to "Next", pagy_url_for(@pagy, @pagy.next), rel: "next" if @pagy.next %>
    </nav>
  <% end %>
<% elsif params.values_at(:query, :notebook_id, :status).any?(&:present?) %>
  <p class="empty">No notes match these filters.</p>
<% else %>
  <p class="empty">No notes yet. <%= link_to "Write your first note", new_note_path %>.</p>
<% end %>
