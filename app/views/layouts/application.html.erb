<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Margin Notes" : "Margin Notes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "Margin Notes", root_path, class: "site-name" %>
      <% if current_user %>
        <nav aria-label="Main">
          <%= link_to "Notes", notes_path %>
          <%= link_to "Notebooks", notebooks_path %>
        </nav>
        <div class="account">
          <span><%= current_user.email %></span>
          <%= button_to "Sign out", session_path, method: :delete %>
        </div>
      <% end %>
    </header>

    <main>
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
