<% content_for :title, "Notebooks" %>

<div class="page-heading">
  <h1>Notebooks</h1>
  <%= link_to "New notebook", new_notebook_path, class: "button" %>
</div>

<% if @notebooks.any? %>
  <ul class="notebooks">
    <% @notebooks.each do |notebook| %>
      <li>
        <%= link_to notebook.name, notes_path(notebook_id: notebook.id) %>
        <%= link_to "Settings", edit_notebook_path(notebook), class: "secondary", aria: { label: "#{notebook.name} settings" } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty">You have no notebooks yet. Create one to start taking notes.</p>
<% end %>
