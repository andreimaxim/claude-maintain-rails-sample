<%= form_with model: notebook, class: "stacked-form" do |form| %>
  <%= render "errors", record: notebook %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>

  <% if notebook.persisted? %>
    <div class="field">
      <span class="label">Slug</span>
      <code class="slug"><%= notebook.slug %></code>
      <%= form.hidden_field :slug %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :export_heading %>
    <%= form.text_field :export_heading %>
  </div>

  <div class="actions">
    <%= form.submit notebook.persisted? ? "Save settings" : "Create notebook" %>
    <%= link_to "Cancel", notebooks_path %>
  </div>
<% end %>
